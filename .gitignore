# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environment
.venv/
venv/
env/

# Packaging
*.egg-info/
dist/
build/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment / secrets
.env
.env.*
*.pem
*.key

# Source photos — keep physically, do not commit
data/input/

# Upload inbox — runtime data, do not commit
data/inbox/

# Runtime databases
*.db
*.sqlite
*.sqlite3

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Runtime previews
data/preview/

# Scratch output of measurements and scans (montages, JSON dumps) — keep
# physically, do not commit
data/output/

# Query images of a media search: they exist only while the job runs
data/media_search/

# Local test photo corpus — keep physically, do not commit
test/

# Agent tooling / worktrees
.claude/

# Local backup copies of edited files
*.before_*
*.bak

# Scratch of scripts/fingerprint_size_experiment.py (photos + numpy artifacts)
data/output/fingerprint_size_experiment/
