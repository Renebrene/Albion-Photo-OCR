# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environment
.venv/
.venv-scene-scan/
venv/
env/

# Packaging
*.egg-info/
dist/
build/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment / secrets
.env
.env.*
*.pem
*.key

# Source photos — keep physically, do not commit
data/input/

# Upload inbox — runtime data, do not commit
data/inbox/

# Runtime databases
*.db
*.sqlite
*.sqlite3

# Generated media derivatives (for video edits)
data/video_derivatives/

# Temporary copies of source files
app/ingest/runner.py.tmp.*

# Local JS tooling dependencies
node_modules/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Runtime previews
data/preview/

# Scratch output of measurements and scans (montages, JSON dumps) — keep
# physically, do not commit
data/output/

# Query images of a media search: they exist only while the job runs
data/media_search/

# Local test photo corpus — keep physically, do not commit
test/

# Agent tooling / worktrees
.claude/

# Local backup copies of edited files
*.before_*
*.bak

# Scratch of scripts/fingerprint_size_experiment.py (photos + numpy artifacts)
data/output/fingerprint_size_experiment/

# Billboard branch: derived crops and local detector weights (never commit)
data/crops/
data/models/
weights/
*.pt

# Windows demo deployment: local env, data and photo drop folder
deploy/windows/.env.demo
deploy/windows/data/
deploy/windows/photos/*
!deploy/windows/photos/README.txt
!deploy/windows/.env.demo.example
