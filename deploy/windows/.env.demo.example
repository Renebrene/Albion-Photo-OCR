# Demo environment for deploy/windows/docker-compose.yml.
# Copy to .env.demo and change the database password.
#
# SECURITY: SCENE_AUTH_REQUIRED=0 is for an isolated demo machine only.
# Never expose this stack to the internet or an untrusted LAN.

INGEST_DB_HOST=db
INGEST_DB_PORT=5432
INGEST_DB_NAME=photobase
INGEST_DB_USER=photobase
INGEST_DB_PASSWORD=change-me-demo

SCENE_API_HOST=0.0.0.0
SCENE_API_PORT=8010
SCENE_AUTH_REQUIRED=0
SCENE_CORS_ORIGINS=http://localhost:8010

# Paths INSIDE the container. ./photos on Windows is mounted as /photos,
# ./data as /app/data.
SCENE_DATA=/app/data
SCENE_PREVIEW_ROOT=/app/data/preview
SCENE_INBOX=/app/data/inbox
SCENE_CROPS_ROOT=/app/data/crops
SCENE_RUN_LOG_ROOT=/app/data/logs
SCENE_ORIGINALS_ROOTS=/photos
SCENE_SOURCE_FOLDER=/photos
SCENE_SOURCE_ROOTS=/photos

# Billboard detector weights are baked into the image.
SCENE_BILLBOARD_MODEL=/app/models/yolov8s-worldv2.pt
SCENE_NATIVE_PICKER=0

# Video: ffmpeg comes with the image.
SCENE_FFMPEG_BIN=/usr/bin/ffmpeg
SCENE_FFPROBE_BIN=/usr/bin/ffprobe
SCENE_VIDEO_PREVIEW_ROOT=/app/data/preview/videos
SCENE_VIDEO_STORYBOARD_ROOT=/app/data/preview/videos/storyboards
SCENE_VIDEO_DERIVATIVES_ROOT=/app/data/video_derivatives
SCENE_INGEST_MAX_VIDEO_BYTES=314572800
SCENE_INGEST_MAX_VIDEO_SECONDS=20
SCENE_VIDEO_ENCODER=cpu

# QWEN: optional. Install Ollama for Windows, pull qwen3-vl:4b-instruct,
# then restart the qwen-worker.
OLLAMA_URL=http://host.docker.internal:11434
QWEN_MODEL=qwen3-vl:4b-instruct
QWEN_KEEP_ALIVE=10m
QWEN_UNLOAD_ON_IDLE=1

# CPU-only demo.
SCENE_DEVICE=cpu
SCENE_DINO_WORKERS=1
SCENE_DINO_BATCH=1
