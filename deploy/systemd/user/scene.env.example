# Environment for the PhotoBAse *user* services.
#
# Install as ~/.config/scene-fingerprint.env with mode 600:
#   install -m 600 deploy/systemd/user/scene.env.example ~/.config/scene-fingerprint.env
# It carries the database password: never commit a filled-in copy.

# --- PostgreSQL ---
INGEST_DB_HOST=127.0.0.1
INGEST_DB_PORT=5432
INGEST_DB_NAME=photobase_ingest_test
INGEST_DB_USER=lora_ingest
INGEST_DB_PASSWORD=CHANGE_ME

# --- API ---
SCENE_API_HOST=0.0.0.0
SCENE_API_PORT=8010
SCENE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Auth (fail-closed; set the first password with scripts/set_password.py) ---
SCENE_AUTH_REQUIRED=1

# --- Paths (originals are only served from below this root) ---
# Point at the mounted photo volume on the real server.
SCENE_ORIGINALS_ROOTS=/mnt/photos

# --- INGEST working folder ---
# Default folder scanned for new photos (the UI can change it; the database
# value wins). SCENE_SOURCE_ROOTS optionally restricts which folders may be
# selected/scanned (comma-separated); empty = any readable directory.
SCENE_SOURCE_FOLDER=/mnt/photos/inbox
SCENE_SOURCE_ROOTS=/mnt/photos

# --- Processing/performance ---
SCENE_DINO_WORKERS=1
SCENE_DINO_BATCH=1
SCENE_DB_POOL=1
SCENE_DB_POOL_MIN=1
SCENE_DB_POOL_MAX=10

# --- QWEN / Ollama ---
OLLAMA_URL=http://127.0.0.1:11434
QWEN_MODEL=qwen3-vl:4b-instruct
QWEN_KEEP_ALIVE=10m
QWEN_UNLOAD_ON_IDLE=1

# --- Native OS folder dialog for the fingerprint window -----------------------
# Needs a desktop session on the server (DISPLAY). Leave it off when the web UI
# is used from other machines - the in-app folder browser works everywhere.
# SCENE_NATIVE_PICKER=1

# --- Fingerprint building -----------------------------------------------------
# How long a paused build waits for the resume before it fails (seconds).
# SCENE_PAUSE_MAX_SECONDS=300

# --- Video ingest and transcode -----------------------------------------------
# Enable video ingest/transcode/trim/storyboard only after migrations 026-030
# are applied to the intended DB and the user-service smoke test passes.
SCENE_FFMPEG_BIN=/home/alexice/.config/CherryStudio/Toolchain/mise/installs/conda-ffmpeg/9.0.2/bin/ffmpeg
SCENE_FFPROBE_BIN=/home/alexice/.config/CherryStudio/Toolchain/mise/installs/conda-ffmpeg/9.0.2/bin/ffprobe
SCENE_VIDEO_PREVIEW_ROOT=/home/alexice/scene-fingerprint/data/preview/videos
SCENE_VIDEO_STORYBOARD_ROOT=/home/alexice/scene-fingerprint/data/preview/videos/storyboards
SCENE_VIDEO_DERIVATIVES_ROOT=/home/alexice/scene-fingerprint/data/video_derivatives
SCENE_INGEST_MAX_VIDEO_BYTES=314572800
SCENE_INGEST_MAX_VIDEO_SECONDS=20
# auto uses verified NVENC (bounded concurrency), otherwise half-core CPU pool.
SCENE_VIDEO_ENCODER=auto
# SCENE_VIDEO_TRANSCODE_WORKERS=1
# SCENE_VIDEO_TRANSCODE_TIMEOUT=1800

# --- Preview format -----------------------------------------------------------
# webp (default): -46 % against JPEG q90 at the same 1280 px, no visible
# difference on 1:1 crops (docs/preview_experiment_20261022.md). jpeg keeps the
# old behaviour. Existing files keep working after a switch: the API and QWEN
# fall back to the previous format until a photo is regenerated
# (scripts/rebuild_previews.py).
SCENE_PREVIEW_FORMAT=webp
# Encode quality. Empty/absent -> the format default (webp 80, jpeg 90).
# SCENE_PREVIEW_QUALITY=80
# SCENE_PREVIEW_SMALL_SIZE=320
# SCENE_PREVIEW_MIDDLE_SIZE=1280

# --- Albion file storage (optional) -------------------------------------------
# Fallback only: values saved in Настройки → Файлохранилище Albion win.
# Issue the token in Albion:
#   manage_tokens.py add "Photobase" --scopes upload,download --folder <uuid>
# ALBION_BASE_URL=https://files.example.ru
# ALBION_API_KEY=alb_...
# ALBION_FOLDER_ID=
# ALBION_LINK_TTL_DAYS=90
# ALBION_UPLOAD_TIMEOUT=120
