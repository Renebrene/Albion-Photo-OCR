[Unit]
Description=PhotoBAse retention cleanup (user)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/alexice/projects/albion-photobase
EnvironmentFile=/home/alexice/.config/scene-fingerprint.env
ExecStart=/home/alexice/projects/albion-photobase/.venv/bin/python scripts/cleanup_job_queue.py --json
ExecStart=/home/alexice/projects/albion-photobase/.venv/bin/python scripts/cleanup_crops.py --older-than-days 90 --json
# Карантин превью (файлы, перенесённые cleanup_missing_originals): держим 10
# дней на обратимый разбор, потом чистим. Ежедневный запуск с порогом 10 дней
# даёт запрошенную уборку «каждые 10 дней».
ExecStart=/home/alexice/projects/albion-photobase/.venv/bin/python scripts/cleanup_preview_quarantine.py --older-than-days 10 --json
# CLIP-индекс «Похожих»: инкрементальное дование новых кропов. GPU не
# трогается (CUDA_VISIBLE_DEVICES=""), полный пересбор делается вручную
# (--full); docs/clip_search.txt.
ExecStart=/bin/sh -c 'CUDA_VISIBLE_DEVICES= /home/alexice/projects/albion-photobase/.venv/bin/python scripts/clip_rebuild.py --json'
Nice=10
TimeoutStartSec=3600
