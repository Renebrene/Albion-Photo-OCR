[Unit]
Description=PhotoBAse API (FastAPI + built SPA)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Папка без пробелов и скобок: systemd не принимает такие пути в WorkingDirectory.
WorkingDirectory=/home/alexice/albion-photobase
EnvironmentFile=/home/alexice/.config/scene-fingerprint.env
ExecStart=/home/alexice/albion-photobase/.venv/bin/python -m uvicorn app.api.main:app --host 0.0.0.0 --port 8010
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
