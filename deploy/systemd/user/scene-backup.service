[Unit]
Description=PhotoBAse backup: PostgreSQL, fingerprints, logs, env (user)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/alexice/projects/albion-photobase
EnvironmentFile=/home/alexice/.config/scene-fingerprint.env
Environment=SCENE_BACKUP_DIR=/media/alexice/TEST/albion-photobase-backups
ExecStart=/home/alexice/projects/albion-photobase/.venv/bin/python scripts/backup_db.py --json
ExecStart=/home/alexice/projects/albion-photobase/.venv/bin/python scripts/backup_data.py --json
Nice=10
TimeoutStartSec=3600
