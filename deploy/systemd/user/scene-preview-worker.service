[Unit]
Description=PhotoBAse photo preview worker
After=network-online.target scene-api.service
Wants=network-online.target scene-api.service

[Service]
Type=simple
WorkingDirectory=/home/alexice/scene-fingerprint
EnvironmentFile=/home/alexice/.config/scene-fingerprint.env
# The queue worker is singular; photo-level parallel CPU work stays inside
# app.preview.pipeline and is bounded by SCENE_PREVIEW_WORKERS (default half cores).
ExecStart=/home/alexice/scene-fingerprint/.venv/bin/python -m app.jobs.worker --watch --only PHOTO_PREVIEW --parallel 1 --requeue-stale 30 --interval 2
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
