# Environment for scene-api / scene-worker systemd units.
#
# Copy to /etc/scene-fingerprint.env and fill in the real values.
# Keep the file readable only by root and the service user:
#   sudo install -m 0640 -o root -g scene scene.env.example /etc/scene-fingerprint.env
#
# Do NOT commit a filled-in copy: it carries the database password.

# --- PostgreSQL (INGEST_DB_* convention) ---
INGEST_DB_HOST=127.0.0.1
INGEST_DB_PORT=5432
INGEST_DB_NAME=photobase_ingest_test
INGEST_DB_USER=lora_ingest
INGEST_DB_PASSWORD=CHANGE_ME

# --- API ---
SCENE_API_HOST=0.0.0.0
SCENE_API_PORT=8010
# Comma-separated browser origins allowed by CORS (no wildcard in production).
SCENE_CORS_ORIGINS=https://photos.example.com

# --- Authentication ---
# Fail-closed: authentication is required by default. Only set to 0 for a
# fully trusted, network-isolated local box.
SCENE_AUTH_REQUIRED=1
# Service tokens (optional): token:scope1|scope2, comma separated ("*" = all).
SCENE_API_TOKENS=
# Login requires a per-user password; seeded users have none. Set the first
# password once with: python scripts/set_password.py <username>

# --- Paths ---
SCENE_DATA=/opt/scene-fingerprint/data
SCENE_PREVIEW_ROOT=/opt/scene-fingerprint/data/preview
SCENE_INBOX=/opt/scene-fingerprint/data/inbox
# Allowed roots for serving original files (comma-separated). Empty -> originals
# are refused. Point this at the mounted photo volume.
SCENE_ORIGINALS_ROOTS=/mnt/photos

# --- INGEST working folder ---
# Default folder scanned for new photos (the UI can change it; the database
# value wins). SCENE_SOURCE_ROOTS optionally restricts which folders may be
# selected/scanned (comma-separated); empty = any readable directory.
SCENE_SOURCE_FOLDER=/mnt/photos/inbox
SCENE_SOURCE_ROOTS=/mnt/photos

# --- DINO ---
# Worker threads per batch; 1 is recommended (CPU-only runner, threads do not
# help much). 0 = automatic (half of logical CPUs).
SCENE_DINO_WORKERS=1
# Images per DINO forward pass. 1 leaves behaviour unchanged; 4-8 is verified
# equivalent (same best_id, scores within 1e-6) and faster on compute.
SCENE_DINO_BATCH=1

# --- Database connection pool ---
# Pooled connections for the API/worker (0 disables pooling).
SCENE_DB_POOL=1
SCENE_DB_POOL_MIN=1
SCENE_DB_POOL_MAX=10

# --- Uploads ---
SCENE_UPLOAD_MAX_BYTES=26214400
SCENE_UPLOAD_MAX_FILES=20

# --- QWEN / Ollama ---
OLLAMA_URL=http://127.0.0.1:11434
QWEN_MODEL=qwen3-vl:4b-instruct
# Keep the model resident between jobs (duration); "0" unloads after each.
QWEN_KEEP_ALIVE=10m
# Explicit unload when the job queue drains.
QWEN_UNLOAD_ON_IDLE=1

# --- QWEN cloud provider (optional; images leave the machine) ---
# provider: ollama (default) | openai
QWEN_PROVIDER=ollama
# Base URL for the OpenAI-compatible endpoint, e.g. https://api.openai.com/v1
QWEN_BASE_URL=
# The API key is stored via settings (UI: Настройки → QWEN), not in this file.

# --- Native OS folder dialog for the fingerprint window -----------------------
# Needs a desktop session on the server (DISPLAY). Leave it off when the web UI
# is used from other machines - the in-app folder browser works everywhere.
# SCENE_NATIVE_PICKER=1

